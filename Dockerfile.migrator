FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS migrate

WORKDIR /app

RUN apk add --no-cache openssl \
    && npm install --prefix /opt/migrator --no-audit --no-fund prisma@5.6.0

COPY ./prisma/ /app/prisma/

CMD ["node", "/opt/migrator/node_modules/prisma/build/index.js", "migrate", "deploy", "--schema=/app/prisma/schema.prisma"]
